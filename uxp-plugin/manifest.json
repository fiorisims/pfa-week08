{
  "manifestVersion": 5,
  "id": "com.fiorisims.colorscript.fixes",
  "name": "Color Script (fixes)",
  "version": "1.8.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.2.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "colorScriptPanel",
      "label": { "default": "Color Script (fixes)" },
      "minimumSize": { "width": 230, "height": 160 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 280, "height": 540 },
      "preferredFloatingSize": { "width": 280, "height": 560 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/panel.png", "scale": [1, 2], "theme": ["darkest", "dark", "medium", "lightest", "light"] }
      ]
    }
  ],
  "icons": [
    { "width": 23, "height": 23, "path": "icons/panel.png", "scale": [1, 2], "theme": ["darkest", "dark", "medium", "lightest", "light"], "species": ["generic"] }
  ],
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": {
      "domains": "all"
    }
  }
}
